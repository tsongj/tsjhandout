% 选择题选项自动排版 \xx{A}{B}{C}{D}
\newlength{\lab} \newlength{\lb} \newlength{\lc} \newlength{\ld}
\newlength{\lhalf} \newlength{\lquarter} \newlength{\lmax}
\newcommand{\xx}[4]{%
\mbox{}\[.5pt]%
\settowidth{\lab}{A.~#1~~~}%
\settowidth{\lb}{B.~#2~~~}%
\settowidth{\lc}{C.~#3~~~}%
\settowidth{\ld}{D.~#4~~~}%
\setlength{\lmax}{\lab}%
\ifdim\lb>\lmax \setlength{\lmax}{\lb}\fi
\ifdim\lc>\lmax \setlength{\lmax}{\lc}\fi
\ifdim\ld>\lmax \setlength{\lmax}{\ld}\fi
\setlength{\lhalf}{0.5\linewidth}%
\setlength{\lquarter}{0.25\linewidth}%
\ifdim\lmax>\lhalf
\noindent{}A.~#1 \ B.~#2 \ C.~#3 \ D.~#4
\else
\ifdim\lmax>\lquarter
\noindent\makebox[\lhalf][l]{A.~#1~~~}\makebox[\lhalf][l]{B.~#2~~~}\%
\makebox[\lhalf][l]{C.~#3~~~}\makebox[\lhalf][l]{D.~#4~~~}%
\else
\noindent\makebox[\lquarter][l]{A.~#1~~~}\makebox[\lquarter][l]{B.~#2~~~}%
\makebox[\lquarter][l]{C.~#3~~~}\makebox[\lquarter][l]{D.~#4~~~}%
\fi
\fi
}
